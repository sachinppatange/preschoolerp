# Uploaded media — serve as static files (Hostinger / LiteSpeed / Apache).
<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

Options -Indexes

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|gif|webp)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
