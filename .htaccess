# Pioneer Play School — Hostinger / Apache
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Old public domain → current live site
    RewriteCond %{HTTP_HOST} ^(www\.)?pioneerplayschool\.preschoolapp\.in$ [NC]
    RewriteRule ^ https://app.preschoolapp.in%{REQUEST_URI} [L,R=301]
</IfModule>
